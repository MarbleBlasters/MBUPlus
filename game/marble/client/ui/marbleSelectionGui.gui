$totalMarbles = 43;

function marbleSelectionGui::onWake( %this )
{
   // Load marble picker mission
   GameMissionInfo.setMode( GameMissionInfo.SpecialMode );
   GameMissionInfo.selectMission( 0 );
   commandToServer('SetMarble', $pref::marbleIndex);
   commandToServer('SpawnMarblePickerMarble');
}

function marbleSelectionGui::show(%this, %backGui)
{

   MarbleSelectionArray.clear();
   //MarbleList.clear();
   //MarbleList.extent = "685 0";

   // Change THIS variable to add/remove marbles
   %numMarbles = $totalMarbles;
   if($toggleDev){
      %customMarbleIndex = -1;//%numMarbles + 1;

      %boxName = "MarbleSelection_1_" @ %customMarbleIndex;
      %boxNameButton = "MarbleSelectionButton_1_" @ %customMarbleIndex;
      %imgName = "MarbleSelectionImg_1_" @ %customMarbleIndex;
      %marbleButtonPreviewName = "Marble_1_" @ %customMarbleIndex;

      %box = new GuiControl(%boxName) {
         profile = "GuiDefaultProfile";
         horizSizing = "width";
         vertSizing = "bottom";
         position = "0 0";
         extent = "86 86";
         minExtent = "8 8";
         visible = "1";

         new GuiObjectView(%marbleButtonPreviewName) {
               profile = "GuiDefaultProfile";
               horizSizing = "right";
               vertSizing = "bottom";
               position = "0 0";
               extent = "86 86";
               minExtent = "8 8";
               visible = "1";
               helpTag = "0";
               cameraZRot = "0";
               forceFOV = "0";
               model = "~/data/shapes/balls/marble00.dts";
               skin = "base";
               cameraRotX = "0.5";
               cameraZRotSpeed = "0.001";
               orbitDistance = "0.65";
               autoSize = "1";
               cubeMap = "sky_picker";
            };

            new GuiBitmapCtrl(%imgName) {
            profile = "GuiDefaultProfile";
            horizSizing = "relativeHeight";
            vertSizing = "relativeHeight";
            position = "12 12";
            extent = "64 64";
            minExtent = "8 8";
            visible = "1";
            bitmap = "./menu/marblepicker/special_marble.png";
            wrap = "0";
               helpTag = "0";

            };

            new GuiButtonBaseCtrl(%boxNameButton) {
               profile = "GuiDefaultProfile";
               horizSizing = "width";
               vertSizing = "bottom";
               position = "0 0";
               extent = "86 86";
               minExtent = "8 8";
               visible = "1";
               command = "ChooseThisMarble(" @ %customMarbleIndex @ ");";

            };
      };

      MarbleSelectionArray.add(%box);
   }
   %marbleString = "";
   for( %i = 0; %i < %numMarbles; %i++ )
   {
      %this.addMarble(1, %i, $pref::marbleIndex);
   }
   
   

	if (%backGui !$= "")
      %this.backGui = %backGui;    
   
   RootGui.setA( $Text::OK );
   RootGui.setTitle( $Text::About0Title );
   //RootGui.setTitle( "CHOOSE YOUR MARBLE" );

   MarbleScroll.setProfile("GameScrollProfile");
   //MarbleScroll.setTop(14);
   //MarbleScroll.setTop(16);

   %textNumber = $pref::marbleIndex + 1;
   Picker_ChosenMarbleNumber.setText(%textNumber @ "/" @ %numMarbles);
   Picker_ChosenMarbleText.setText($MarbleName[$pref::marbleIndex]);
}

function marbleSelectionGui::addMarble(%this, %catId, %marbleId, %selectedMarble) {
   //echo(%marbleId);
	//%w = getWord(AchievList.getExtent(), 0);
	//%h = 64;
	//%x = 0;
	//%y = getWord(AchievList.getExtent(), 1);

   %currentMarbleIndex = %marbleId + 1;

	%boxName = "MarbleSelection_" @ %catId @ "_" @ %currentMarbleIndex;
   %boxNameButton = "MarbleSelectionButton_" @ %catId @ "_" @ %currentMarbleIndex;
	%imgName = "MarbleSelectionImg_" @ %catId @ "_" @ %currentMarbleIndex;
   %marbleButtonPreviewName = "Marble_" @ %catId @ "_" @ %currentMarbleIndex;

   %marbleSkin = %currentMarbleIndex;
   if(%currentMarbleIndex < 10){
      %marbleSkin = "0" @ %currentMarbleIndex;
   }

   %cubemapSkin = "sky_picker";
   if(%currentMarbleIndex == 26 || %currentMarbleIndex == 27 || %currentMarbleIndex == 28 || %currentMarbleIndex == 29 || %currentMarbleIndex == 30){
      //Color fix
      %cubemapSkin = "sky_environment";
   }

	%box = new GuiControl(%boxName) {
		profile = "GuiDefaultProfile";
		horizSizing = "width";
		vertSizing = "bottom";
		position = "0 0";
		extent = "86 86";
		minExtent = "8 8";
		visible = "1";

      new GuiObjectView(%marbleButtonPreviewName) {
            profile = "GuiDefaultProfile";
            horizSizing = "right";
            vertSizing = "bottom";
            position = "0 0";
            extent = "86 86";
            minExtent = "8 8";
            visible = "1";
            helpTag = "0";
            cameraZRot = "0";
            forceFOV = "0";
            model = "~/data/shapes/balls/marble" @ %marbleSkin @ ".dts";
            skin = "base";
            cameraRotX = "0.5";
            cameraZRotSpeed = "0.001";
            orbitDistance = "0.65";
            autoSize = "1";
            cubeMap = %cubemapSkin;
         };

         new GuiBitmapCtrl(%imgName) {
         profile = "GuiDefaultProfile";
         horizSizing = "relativeHeight";
         vertSizing = "relativeHeight";
         position = "12 12";
         extent = "64 64";
         minExtent = "8 8";
         visible = "1";
         bitmap = "./menu/marblepicker/not_selected_marble.png";
         wrap = "0";
            helpTag = "0";

         };

         new GuiButtonBaseCtrl(%boxNameButton) {
            profile = "GuiDefaultProfile";
            horizSizing = "width";
            vertSizing = "bottom";
            position = "0 0";
            extent = "86 86";
            minExtent = "8 8";
            visible = "1";
            command = "ChooseThisMarble(" @ %marbleId @ ");";

         };
	};

   %currentMarble = %selectedMarble + 1;
   if(%currentMarble == %currentMarbleIndex){
      %imgName.setBitmap("./menu/marblepicker/selected_marble.png");
   } else {
      %imgName.setBitmap("./menu/marblepicker/not_selected_marble.png");
   }

	MarbleSelectionArray.add(%box);
}

function ChooseThisMarble(%number){
   echo("Selecting Marble: " @ %number);
   $pref::marbleIndex = %number;
   commandToServer('SetMarble', $pref::marbleIndex);
   commandToServer('SpawnMarblePickerMarble');
   %numMarbles = $totalMarbles;
   for( %i = 0; %i < %numMarbles; %i++ )
   {
      %currentMarbleIndex = %i + 1;
      %newImgName = "MarbleSelectionImg_1_" @ %currentMarbleIndex;

      //echo(%newImgName);

      %currentMarble = %number + 1;
      if(%currentMarble == %currentMarbleIndex){
         %newImgName.setBitmap("./menu/marblepicker/selected_marble.png");
      } else {
         %newImgName.setBitmap("./menu/marblepicker/not_selected_marble.png");
      }


      //%this.addMarble(1, %i, $pref::marbleIndex);
   }
   %textNumber = %number + 1;
   Picker_ChosenMarbleNumber.setText(%textNumber @ "/" @ %numMarbles);
   Picker_ChosenMarbleText.setText($MarbleName[$pref::marbleIndex]);
}

function marbleSelectionGui::onA(%this)
{
   // Delete the marble just so it doesn't show up anywhere else
   commandToServer('DestroyMarblePickerMarble');
   
   // Save the profile
   if (isPCBuild())
   {
      saveUserProfile();
   } else
   {
      %string = CurrentGamerProfile.packProfile();
      CurrentGamerProfile.saveProfile(%string);
   }
   
   // Return to selected mission
   GameMissionInfo.setMode( GameMissionInfo.SPMode );
   GameMissionInfo.selectMission( GameMissionInfo.getCurrentIndex() );
   RootGui.setContent(HelpAndOptionsGui, %this.backGui);
}
